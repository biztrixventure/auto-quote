# Only needed when running docker-compose.yml OUTSIDE Coolify (Coolify fills SERVICE_* itself).
# Copy to .env next to docker-compose.yml and fill in. Generate secrets with: openssl rand -hex 32

# Public https address of the site (no trailing slash).
SITE_URL="https://www.yourdomain.com"

# Database (letters and digits only in the password, it goes inside a URL).
SERVICE_USER_POSTGRES="vertex"
SERVICE_PASSWORD_POSTGRES=""
POSTGRES_DB="vertex"

# First /admin sign-in creates the owner account from these.
ADMIN_USER="admin"
SERVICE_PASSWORD_ADMIN=""

# Signs share-image URLs.
SERVICE_PASSWORD_64_OGSECRET=""

# Quoting and lead distribution (see .env.example for what each value means).
RATER_PROVIDER="demo"
LEAD_DISTRIBUTION="demo"
LEAD_POST_URL=""
LEAD_POST_API_KEY=""
NEXT_PUBLIC_TRUSTEDFORM_ENABLED="false"

# Optional new-lead alerts.
RESEND_API_KEY=""
NOTIFY_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Database backups.
BACKUP_EVERY_HOURS="24"
BACKUP_KEEP_DAYS="14"
