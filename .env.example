# Local development settings. For production see docker-compose.yml and DEPLOY.md.

# PostgreSQL started by `npm run db:up` (docker-compose.dev.yml).
DATABASE_URL="postgresql://vertex:vertex_dev@localhost:5432/vertex?schema=public"

# Public address of the site (production: your https domain).
SITE_URL="http://localhost:3000"

# Admin dashboard login (/admin). CHANGE THESE.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-now"

# Quoting provider: demo | ezlynx | turborater
RATER_PROVIDER="demo"
RATER_TIMEOUT_MS="8000"

# Lead distribution for leads that get no quotes: off | demo | webhook
LEAD_DISTRIBUTION="demo"
# Used when LEAD_DISTRIBUTION="webhook" (LeadsPedia, LeadProsper, boberdoo, etc.)
LEAD_POST_URL=""
LEAD_POST_API_KEY=""

# Set to "true" after adding your TrustedForm account snippet (see src/components/TrustedForm.tsx)
NEXT_PUBLIC_TRUSTEDFORM_ENABLED="false"

# Signs share-image URLs (/api/og). Use a long random value, e.g. `openssl rand -base64 32`.
OG_SECRET="change-me"
